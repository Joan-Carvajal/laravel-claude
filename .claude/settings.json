{
    "permissions": {
        "allow": [
            "Bash(./vendor/bin/sail artisan test:*)",
            "Bash(./vendor/bin/sail composer qa:*)",
            "Bash(./vendor/bin/sail bin pint:*)",
            "Bash(./vendor/bin/sail bin phpstan:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./secrets/**)",
            "Write(./.env)",
            "Edit(./.env)",
            "Bash(rm -rf:*)",
            "Bash(./vendor/bin/sail artisan migrate:fresh*)",
            "Bash(./vendor/bin/sail artisan migrate:reset*)",
            "Bash(./vendor/bin/sail artisan db:wipe*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pint.sh",
                        "timeout": 30
                    },
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/phpstan.sh",
                        "timeout": 90
                    },
                    {
                                            "type": "command",
                                            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/test.sh",
                                            "async": true,
                                            "timeout": 180
                                        }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-check.sh",
                        "timeout": 5
                    }
                ]
            }
        ]
    }
}