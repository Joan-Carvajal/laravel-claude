{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail composer qa)",
      "Bash(./vendor/bin/sail composer test)",
      "Bash(./vendor/bin/sail composer stan)",
      "Bash(./vendor/bin/sail composer pint)",
      "Bash(./vendor/bin/sail composer rector:dry)",
      "Bash(./vendor/bin/sail artisan test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)",
      "Bash(./vendor/bin/sail artisan migrate:fresh *)",
      "Bash(./vendor/bin/sail artisan migrate:reset *)",
      "Bash(./vendor/bin/sail artisan db:wipe *)"
    ],
    "ask": [
      "Bash(./vendor/bin/sail composer rector)",
      "Bash(git push *)",
      "Bash(dangerouslyDisableSandbox:true)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.sh",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pint.sh",
            "args": [],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/phpstan.sh",
            "args": [],
            "timeout": 90
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/test.sh",
            "args": [],
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/context-check.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "allowRead": [
        "./.env.example"
      ]
    },
    "excludedCommands": [
      "./vendor/bin/sail *"
    ]
  }
}
